{erl_opts, [debug_info]}.

%% Add weberl as a dependency, e.g.:
%%   {deps, [{weberl, {git, "<repository url>", {branch, "main"}}}]}.
%% For local development, place or symlink weberl in _checkouts/weberl.
%%
%% src/views/** is compiled by default: rebar3 compiles `src' recursively,
%% so no extra build configuration is needed for views below src/.
{deps, []}.
