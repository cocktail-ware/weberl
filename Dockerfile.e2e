# Image of the Node tests: the unit tests of the browser scripts and the
# Playwright browser tests. It is Microsoft's Playwright image (Node, Chromium,
# Firefox, WebKit and their system libraries). The tag must match the
# @playwright/test version in test/node/package.json, because the browser
# builds belong to one Playwright version.
#
#   podman build -f Dockerfile.e2e -t weberl-e2e .
#
# Only the package manifest goes into the image; the tests themselves are
# mounted from test/node/ when a run starts (test/e2e/run.sh).
ARG PLAYWRIGHT_VERSION=1.64.1
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

# Dependencies go to /node_modules so that they are found from /work (the
# mounted tests) by Node's lookup through the parent directories.
# certutil (libnss3-tools): to make Chromium trust the fake CA of a run
RUN apt-get update \
    && apt-get install -y --no-install-recommends libnss3-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /
COPY test/node/package.json /package.json
RUN npm install --no-audit --no-fund \
    && npx playwright --version

WORKDIR /work
