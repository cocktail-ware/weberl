{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info]}.

%% No runtime dependencies. The Roadrunner adapter is optional code: a
%% consuming application that uses it declares roadrunner in its own deps.
{deps, []}.

{eunit_opts, [verbose]}.

{profiles, [
    {test, [
        {deps, [
            {roadrunner, {git, "https://github.com/arizona-framework/roadrunner",
                          {tag, "0.13.1"}}}
        ]}
    ]}
]}.
