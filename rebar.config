{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info]}.

%% No runtime dependencies. The Roadrunner adapter is optional code: a
%% consuming application that uses it declares roadrunner in its own deps.
%%
%% erl_file_reloader is a development tool (it watches files, rebuilds, reloads beams and
%% calls `weberl:reload/1'). Weberl does not use it and does not list it in its
%% applications: it is here so that an application that depends on Weberl gets it with
%% the same update and can start it in its dev profile (see "Reloading" in the README).
{deps, [
    {erl_file_reloader, {git, "https://github.com/cocktail-ware/erl_file_reloader.git",
                         {branch, "main"}}}
]}.

{eunit_opts, [verbose]}.

{profiles, [
    {test, [
        {deps, [
            {roadrunner, {git, "https://github.com/arizona-framework/roadrunner",
                          {tag, "0.13.1"}}}
        ]}
    ]}
]}.
