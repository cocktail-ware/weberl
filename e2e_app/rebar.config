{erl_opts, [debug_info]}.

%% The app under test of the browser tests (test/e2e/run.sh). weberl comes from
%% _checkouts/weberl (a symlink to the repository root), so the URL is never
%% fetched.
{deps, [
    {weberl, {git, "https://example.invalid/weberl.git", {branch, "main"}}},
    {roadrunner, {git, "https://github.com/arizona-framework/roadrunner", {tag, "0.13.1"}}}
]}.
