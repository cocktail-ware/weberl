{erl_opts, [debug_info]}.

%% In your own project, replace the weberl URL with the real repository.
%% Here, _checkouts/weberl (a symlink to the repository root) overrides it, so
%% the URL is never fetched. roadrunner is the HTTP server that weberl's
%% default adapter talks to; the application using it declares it.
{deps, [
    {weberl, {git, "https://example.invalid/weberl.git", {branch, "main"}}},
    {roadrunner, {git, "https://github.com/arizona-framework/roadrunner", {tag, "0.13.1"}}},
    %% the development file reloader (example_sup starts it when `reload' is set);
    %% weberl depends on it as well, so a normal project gets it with weberl
    {erl_file_reloader, {git, "https://github.com/cocktail-ware/erl_file_loader.git",
                         {branch, "main"}}}
]}.

{shell, [{config, "config/sys.config"}, {apps, [example]}]}.
